# 复制成 .env 后填写（.env 已在 .gitignore 里，不会被提交）

# 微信推送：微信公众平台测试号 https://mp.weixin.qq.com/debug/cgi-bin/sandbox?t=sandbox/login
# 模板消息内容填：{{title.DATA}} {{content.DATA}}
WX_APPID=
WX_SECRET=
WX_OPENID=
WX_TEMPLATE_ID=

# 可选：iOS Bark 推送
# BARK_KEY=

# 自动下单：取货人信息（登录后账户里已有的会直接用，这里只补空着的项；姓名要和到店出示的证件一致）
ORDER_LAST_NAME=
ORDER_FIRST_NAME=
ORDER_EMAIL=
ORDER_PHONE=
# 付款方式：支付宝 / 微信
ORDER_PAYMENT=支付宝
